{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A user's drug discovery project containing formulation, trial, and packaging data.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this project."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the project was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the project was last updated."
        },
        "formData": {
          "type": "string",
          "description": "JSON stringified form data."
        },
        "formulationResult": {
          "type": "string",
          "description": "JSON stringified formulation result."
        },
        "trialParams": {
          "type": "string",
          "description": "JSON stringified trial parameters."
        },
        "trialResult": {
          "type": "string",
          "description": "JSON stringified trial result."
        },
        "packagingResult": {
          "type": "string",
          "description": "JSON stringified packaging result."
        },
        "step": {
          "type": "string",
          "description": "The current step in the application flow."
        }
      },
      "required": ["userId", "createdAt", "updatedAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback on generated results, used for SLM training.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user providing feedback."
        },
        "projectId": {
          "type": "string",
          "description": "The ID of the project this feedback relates to."
        },
        "stage": {
          "type": "string",
          "description": "The stage of the pipeline (e.g., 'formulation', 'trial', 'packaging')."
        },
        "inputContext": {
          "type": "string",
          "description": "JSON stringified input context (e.g., formData or trialParams)."
        },
        "generatedOutput": {
          "type": "string",
          "description": "JSON stringified output generated by the model."
        },
        "rating": {
          "type": "number",
          "description": "Rating from 1 to 5."
        },
        "comments": {
          "type": "string",
          "description": "User's textual feedback or corrections."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the feedback was submitted."
        }
      },
      "required": ["userId", "projectId", "stage", "inputContext", "generatedOutput", "rating", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing personal and professional demographic data.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user."
        },
        "email": {
          "type": "string",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's full name."
        },
        "age": {
          "type": "number",
          "description": "The user's age."
        },
        "gender": {
          "type": "string",
          "description": "The user's gender."
        },
        "country": {
          "type": "string",
          "description": "The user's country of residence."
        },
        "professionCategory": {
          "type": "string",
          "description": "The category of the user's profession (e.g., Scientist, Doctor, IT Professional)."
        },
        "jobTitle": {
          "type": "string",
          "description": "The user's specific job title."
        },
        "organization": {
          "type": "string",
          "description": "The user's company, university, or hospital."
        },
        "professionalDetails": {
          "type": "string",
          "description": "JSON stringified object containing profession-specific details (e.g., patents, clinical trials, tech stack)."
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "The user's role in the system."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the profile was last updated."
        }
      },
      "required": ["userId", "email", "professionCategory", "updatedAt"]
    },
    "SlmModel": {
      "title": "SlmModel",
      "description": "Represents a fine-tuned Small Language Model trained on user feedback.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who trained the model."
        },
        "modelName": {
          "type": "string",
          "description": "The name of the trained model."
        },
        "status": {
          "type": "string",
          "enum": ["untrained", "training", "deployed"],
          "description": "The current status of the model."
        },
        "trainingSamples": {
          "type": "number",
          "description": "Number of feedback samples used for training."
        },
        "accuracy": {
          "type": "number",
          "description": "Simulated accuracy of the model."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "modelName", "status", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profiles."
    },
    "/models/{modelId}": {
      "schema": {
        "$ref": "#/entities/SlmModel"
      },
      "description": "Stores fine-tuned SLM models for users."
    },
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Stores user projects."
    },
    "/feedbacks/{feedbackId}": {
      "schema": {
        "$ref": "#/entities/Feedback"
      },
      "description": "Stores user feedback for SLM training."
    }
  }
}
