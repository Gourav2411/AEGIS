rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Document ID: {projectId}
    // Fields:
    //   - userId: string (required) - The UID of the user who owns this project.
    //   - createdAt: timestamp (required) - When the project was created.
    //   - updatedAt: timestamp (required) - When the project was last updated.
    //   - formData: string (optional) - JSON stringified form data.
    //   - formulationResult: string (optional) - JSON stringified formulation result.
    //   - trialParams: string (optional) - JSON stringified trial parameters.
    //   - trialResult: string (optional) - JSON stringified trial result.
    //   - packagingResult: string (optional) - JSON stringified packaging result.
    //   - step: string (optional) - The current step in the application flow.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is owner based on document's userId field
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid;
    }
    
    // Ensure userId field is not modified on update
    function uidNotModified() {
      return !('userId' in request.resource.data) ||
        request.resource.data.userId == resource.data.userId;
    }
    
    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // Validate that the document hasn't changed in the fields that are not allowed to be changed
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate optional string (if present, must be string and within length)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProject(data) {
      return hasRequiredFields(['userId', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() < 100 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             isValidOptionalString('formData', 0, 1000000) &&
             isValidOptionalString('formulationResult', 0, 1000000) &&
             isValidOptionalString('trialParams', 0, 1000000) &&
             isValidOptionalString('trialResult', 0, 1000000) &&
             isValidOptionalString('packagingResult', 0, 1000000) &&
             isValidOptionalString('step', 0, 100);
    }

    match /projects/{projectId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && 
                       isValidProject(request.resource.data) && 
                       uidUnchanged();
      allow update: if isDocOwner() && 
                       isValidProject(request.resource.data) && 
                       uidNotModified() &&
                       areImmutableFieldsUnchanged(['createdAt']);
      allow delete: if isDocOwner();
    }
  }
}
